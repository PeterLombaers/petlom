# Configuration for scripts/backup.sh and scripts/deploy.sh.
# Copy to scripts/.env (gitignored) and fill in.

# REQUIRED. An ssh destination: a Host alias from ~/.ssh/config, or user@hostname.
PETLOM_SSH_HOST=

# Directory on the production host containing the checkout and docker-compose.yml.
# Relative paths are resolved from the ssh user's home directory.
PETLOM_REMOTE_DIR=petlom

# Where downloaded database backups are written on this machine.
# Default: <repo>/backups
# PETLOM_BACKUP_DIR=/home/peter/petlom-backups

# Optional. A URL deploy.sh curls after the containers are up, as a health check.
# Without it, deploy.sh only checks that the containers are running.
# PETLOM_HEALTH_URL=https://chess.example.com/api/players/
