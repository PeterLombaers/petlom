# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# The origins your frontend is served from, as a JSON array (no trailing slashes)
# Development:
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Production:
# ALLOWED_ORIGINS=["https://yourdomain.nl"]
