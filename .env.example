# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Database file path.
# Docker deployment: /data/petlom.db (matches the volume mount in docker-compose.yml)
# Local development: database.db (creates the file in the project root)
DATABASE_FP=database.db

# Caddy site address. Controls TLS behaviour automatically:
#   localhost         → HTTPS with a local Caddy CA certificate (install once with: caddy trust)
#   chess.example.com → HTTPS with automatic Let's Encrypt certificate
# Development:
CADDY_HOST=localhost
# Production:
# CADDY_HOST=<use your domain here>

# External ratings come from a chess_player_db instance, which serves both FIDE
# and KNSB. Leave both settings below unset to disable external search and
# rating imports.
#
# Local development (`uv run fastapi dev`), against that project's published
# port — match its API_PORT:
# CHESS_DB_API_BASE_URL=http://127.0.0.1:8001
#
# Docker: do not set CHESS_DB_API_BASE_URL here. Uncomment the line below
# instead, which pulls in docker-compose.chessdb.yml — the backend then joins
# chess_player_db's compose network and reaches it over that, so the instance
# needs no port exposed beyond loopback. Its stack must be running before
# petlom starts.
# COMPOSE_FILE=docker-compose.yml:docker-compose.chessdb.yml

# The page on the club website that embeds the Google Sheet members sign up in.
# Its default is the current sign-up page; set this only when that page moves.
# CLUB_REGISTRATION_URL=https://paulkeres.nl/?page_id=22537

# CORS origins — only needed for local development.
# In Docker deployments the frontend and API share the same origin, so CORS is not triggered.
# Development:
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Docker / production: leave unset or set to []
# ALLOWED_ORIGINS=[]
