# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Database file path.
# Docker deployment: /data/petlom.db (matches the volume mount in docker-compose.yml)
# Local development: database.db (creates the file in the project root)
DATABASE_FP=database.db

# Caddy site address. Controls TLS behaviour automatically:
#   localhost         → HTTPS with a local Caddy CA certificate (install once with: caddy trust)
#   chess.example.com → HTTPS with automatic Let's Encrypt certificate
# Development:
CADDY_HOST=localhost
# Production:
# CADDY_HOST=<use your domain here>

# External ratings come from a chess_player_db instance, which serves both FIDE
# and KNSB. Leave unset to disable external search and rating imports.
# Local instance started with `docker compose up -d` in that project:
# CHESS_DB_API_BASE_URL=http://127.0.0.1:8000

# CORS origins — only needed for local development.
# In Docker deployments the frontend and API share the same origin, so CORS is not triggered.
# Development:
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Docker / production: leave unset or set to []
# ALLOWED_ORIGINS=[]
